        $site_owner = WP_Seed_Pixel_Authority::acquire(0); $owner = WP_Seed_Pixel_Authority::acquire(90020);
        m51_assert(!is_wp_error($site_owner) && !is_wp_error($owner), 'suite_claim'); $checks = array();
        try {
            $clone = clone $owner; $checks['foreign_handle_release_denied'] = !WP_Seed_Pixel_Authority::release($clone) && WP_Seed_Pixel_Authority::valid(90020);
            $token = bin2hex(random_bytes(24));
            m51_assert($wpdb->query($wpdb->prepare("INSERT INTO $table (id,job_id,attachment_id,action,stage,lease,lease_until) VALUES (1,1,90020,'replace','queued',%s,%d)", $token, time() + 60)) === 1, 'insert_fixture');
            $before = WP_Seed_Pixel_Job_Store::item(1);
            $checks['wrong_token_denied'] = is_wp_error(WP_Seed_Pixel_Job_Store::transition($before, 'wrong', 'preparing')) && WP_Seed_Pixel_Job_Store::item(1) === $before;
            m51_assert($wpdb->query('START TRANSACTION') !== false, 'transaction_start'); $changed = WP_Seed_Pixel_Job_Store::transition($before, $token, 'preparing'); m51_assert($wpdb->query('ROLLBACK') !== false, 'transaction_rollback');
            $checks['rollback_exact_and_owner_live'] = !is_wp_error($changed) && WP_Seed_Pixel_Job_Store::item(1) === $before && WP_Seed_Pixel_Authority::valid(90020);
            $changed = WP_Seed_Pixel_Job_Store::transition($before, $token, 'preparing'); $checks['cas_transition_exact'] = !is_wp_error($changed) && (int) $changed['revision'] === 1;
            $checks['stale_revision_denied'] = is_wp_error(WP_Seed_Pixel_Job_Store::transition($before, $token, 'preparing'));
            $wpdb->query("UPDATE $table SET lease_until=0 WHERE id=1"); $expired = WP_Seed_Pixel_Job_Store::item(1);
            $checks['expired_lease_denied'] = is_wp_error(WP_Seed_Pixel_Job_Store::transition($expired, $token, 'ready'));
            $next_token = bin2hex(random_bytes(24));
