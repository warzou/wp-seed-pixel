            $checks['aba_token_denied'] = is_wp_error(WP_Seed_Pixel_Job_Store::transition($next, $token, 'ready'));
            $checks['new_token_allowed'] = !is_wp_error(WP_Seed_Pixel_Job_Store::transition($next, $next_token, 'ready'));
            m51_assert($wpdb->query('START TRANSACTION') !== false && $wpdb->query('COMMIT') !== false, 'transaction_commit'); $checks['commit_does_not_release_owner'] = WP_Seed_Pixel_Authority::valid(90020);
        } finally { $checks['release_exact'] = WP_Seed_Pixel_Authority::release($owner); WP_Seed_Pixel_Authority::release($site_owner); }
        $next_owner = WP_Seed_Pixel_Authority::acquire(90020); m51_assert(!is_wp_error($next_owner), 'post_release_claim');
        $checks['stale_handle_cannot_release_new_owner'] = !WP_Seed_Pixel_Authority::release($owner) && WP_Seed_Pixel_Authority::valid(90020);
        $checks['new_owner_release'] = WP_Seed_Pixel_Authority::release($next_owner);
        m51_assert(!in_array(false, $checks, true), 'suite_checks'); $reply = array('checks' => $checks);
    } elseif ($action === 'cleanup' || $action === 'verify') {
        if ($action === 'cleanup') {
            foreach (m51_lock_names() as $name) { m51_assert($wpdb->get_var($wpdb->prepare('SELECT IS_USED_LOCK(%s)', $name)) === null && !$wpdb->last_error, 'live_worker'); }
            if (m51_table_exists($table)) { m51_assert(m51_table_owned($table), 'table_owner'); m51_assert($wpdb->query("DROP TABLE $table") !== false, 'table_drop'); }
            if (is_dir($dir)) {
