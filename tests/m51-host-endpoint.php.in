                    m51_assert(preg_match('/^(wave(?:2|10)\.lock|slot(?:2|10)-[0-9]|suite\.once)$/', $entry) && !is_link($dir . '/' . $entry), 'file_owner');
                    m51_assert(unlink($dir . '/' . $entry), 'file_delete');
                }
                m51_assert(unlink($dir . '/owner') && rmdir($dir), 'directory_delete');
            }
        }
        clearstatcache(); $locks = 0;
        foreach (m51_lock_names() as $name) { if ($wpdb->get_var($wpdb->prepare('SELECT IS_USED_LOCK(%s)', $name)) !== null) { $locks++; } m51_assert(!$wpdb->last_error, 'lock_inventory'); }
        $reply = array('temporary_tables' => (int) m51_table_exists($table), 'temporary_directories' => (int) file_exists($dir), 'live_test_locks' => $locks);
